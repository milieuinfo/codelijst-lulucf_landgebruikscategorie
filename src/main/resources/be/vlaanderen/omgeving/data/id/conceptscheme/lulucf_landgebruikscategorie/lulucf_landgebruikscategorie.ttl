    skos:inScheme cat:lulucf_landgebruikscategorie;
    skos:notation "60";
    skos:prefLabel "Other land"@nl;
    skos:topConceptOf cat:lulucf_landgebruikscategorie.
cat:lulucf_landgebruikscategorie a skos:ConceptScheme;
    skos:definition "This code list contains an overview of the Flemish land use categories used in the context of the European LULUCF Regulation regarding the reporting of greenhouse gas storage and emissions related to land use changes. "@nl;
    skos:hasTopConcept cat:10, cat:20, cat:30, cat:40, cat:50, cat:60;
    skos:note "This code list contains an overview of the Flemish land use categories used in the context of the European LULUCF Regulation regarding the reporting of greenhouse gas storage and emissions related to land use changes. "@nl;
    skos:prefLabel "LULUCF land use categories"@nl.
